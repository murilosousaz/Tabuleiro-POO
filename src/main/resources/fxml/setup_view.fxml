<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="br.edu.uece.controller.SetupController"
            style="-fx-background-color: linear-gradient(to bottom, #1a5f7a, #0d3b52);">
    
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-padding: 20;">
            <Label text="🎲 JOGO DE TABULEIRO 🎲" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #FFD700;">
                <font>
                    <Font name="System Bold" size="32"/>
                </font>
            </Label>
            <Label text="Estilo Banco Imobiliário" style="-fx-font-size: 16px; -fx-text-fill: #FFFFFF; -fx-font-style: italic;"/>
            <Separator prefWidth="400" style="-fx-background-color: #FFD700;"/>
        </VBox>
    </top>
    
    <center>
        <HBox spacing="30" alignment="CENTER" style="-fx-padding: 30;">
            
            <VBox spacing="15" alignment="TOP_CENTER" style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);">
                <Label text="➕ Adicionar Jogador" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a5f7a;"/>
                
                <Separator prefWidth="300"/>
                
                <VBox spacing="5">
                    <Label text="Nome do Jogador:" style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <TextField fx:id="nomeJogadorField" promptText="Digite o nome..." prefWidth="280"
                               style="-fx-font-size: 14px; -fx-padding: 8; -fx-background-radius: 5; -fx-border-color: #1a5f7a; -fx-border-radius: 5;"/>
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Tipo de Jogador:" style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <ComboBox fx:id="tipoJogadorCombo" prefWidth="280"
                              style="-fx-font-size: 14px; -fx-background-radius: 5;"/>
                    <Label text="• Normal: Joga dados normalmente&#10;• Sorte: Rola 2x, escolhe melhor&#10;• Azarado: Rola 2x, fica com pior" 
                           style="-fx-font-size: 10px; -fx-text-fill: #666; -fx-wrap-text: true;" 
                           prefWidth="280"/>
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Cor do Pino:" style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <ComboBox fx:id="corJogadorCombo" prefWidth="280"
                              style="-fx-font-size: 14px; -fx-background-radius: 5;"/>
                </VBox>
                
                <Button fx:id="adicionarBtn" text="➕ Adicionar Jogador" onAction="#handleAdicionar"
                        prefWidth="280" prefHeight="40"
                        style="-fx-background-color: linear-gradient(to bottom, #43A047, #2E7D32); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;">
                    <font>
                        <Font name="System Bold" size="14"/>
                    </font>
                </Button>
                
                <Label text="(Mínimo: 2 jogadores | Máximo: 6 jogadores)" 
                       style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-font-style: italic;"/>
            </VBox>
            
            <VBox spacing="15" alignment="TOP_CENTER" style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);">
                <Label text="👥 Jogadores Cadastrados" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a5f7a;"/>
                
                <Separator prefWidth="350"/>
                
                <ListView fx:id="listaJogadoresView" prefWidth="350" prefHeight="250"
                          style="-fx-border-color: #1a5f7a; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                
                <Button fx:id="removerBtn" text="🗑️ Remover Selecionado" onAction="#handleRemover"
                        prefWidth="350" prefHeight="35"
                        style="-fx-background-color: linear-gradient(to bottom, #E53935, #C62828); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;">
                    <font>
                        <Font name="System Bold" size="13"/>
                    </font>
                </Button>
            </VBox>
            
        </HBox>
    </center>
    
    <bottom>
        <VBox spacing="15" alignment="CENTER" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-padding: 20;">
            
            <Label fx:id="statusLabel" text="Adicione de 2 a 6 jogadores para começar!" 
                   style="-fx-font-size: 14px; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>
            
            <Button fx:id="iniciarJogoBtn" text="🎮 INICIAR JOGO" onAction="#handleIniciarJogo"
                    prefWidth="400" prefHeight="50"
                    style="-fx-background-color: linear-gradient(to bottom, #FFD700, #FFA000); -fx-text-fill: #1a5f7a; -fx-font-size: 20px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 15, 0, 0, 5);">
                <font>
                    <Font name="System Bold" size="20"/>
                </font>
            </Button>
            
            <Label text="Desenvolvido para disciplina de POO - UECE" 
                   style="-fx-font-size: 10px; -fx-text-fill: rgba(255, 255, 255, 0.7); -fx-font-style: italic;"/>
        </VBox>
    </bottom>
    
</BorderPane>