<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="br.edu.uece.controller.GameController"
            style="-fx-background-color: #123516;">
    
    <top>
        <VBox style="-fx-background-color: rgba(0, 0, 0, 0.2); -fx-padding: 10;">
            <HBox alignment="CENTER" spacing="20">
                <Label text="JOGO DE TABULEIRO" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D4AF37; -fx-letter-spacing: 2;">
                    <font>
                        <Font name="System Bold" size="24"/>
                    </font>
                </Label>
            </HBox>
            
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 4 0 0 0;">
                <Label text="Jogador Atual:" style="-fx-font-size: 13px; -fx-text-fill: #E0E0E0; -fx-font-weight: bold;"/>
                <Label fx:id="jogadorAtualLabel" text="---" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 4 12; -fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 6;"/>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="15" style="-fx-padding: 15;" alignment="CENTER">
            
            <HBox spacing="20" alignment="CENTER">
                
                <VBox spacing="8" style="-fx-background-color: #FDFDFB; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">
                    <Label text="TABULEIRO" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #123516;"/>
                    <Separator/>
                    
                    <GridPane fx:id="tabuleiroGrid" hgap="3" vgap="3" alignment="CENTER"
                              minWidth="670" minHeight="670" maxWidth="670" maxHeight="670"
                              style="-fx-background-color: #1A1A1A; -fx-padding: 6; -fx-background-radius: 8;">
                    </GridPane>
                    
                    <HBox spacing="12" alignment="CENTER" style="-fx-padding: 4 0 0 0;">
                        <HBox spacing="4" alignment="CENTER">
                            <Label style="-fx-background-color: #4CAF50; -fx-pref-width: 10; -fx-pref-height: 10; -fx-background-radius: 2;"/>
                            <Label text="Início" style="-fx-font-size: 10px; -fx-text-fill: #555;"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER">
                            <Label style="-fx-background-color: #FFD700; -fx-pref-width: 10; -fx-pref-height: 10; -fx-background-radius: 2;"/>
                            <Label text="Chegada" style="-fx-font-size: 10px; -fx-text-fill: #555;"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER">
                            <Label style="-fx-background-color: #FF5252; -fx-pref-width: 10; -fx-pref-height: 10; -fx-background-radius: 2;"/>
                            <Label text="Perde Vez" style="-fx-font-size: 10px; -fx-text-fill: #555;"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER">
                            <Label style="-fx-background-color: #2196F3; -fx-pref-width: 10; -fx-pref-height: 10; -fx-background-radius: 2;"/>
                            <Label text="Sorte" style="-fx-font-size: 10px; -fx-text-fill: #555;"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER">
                            <Label style="-fx-background-color: #E91E63; -fx-pref-width: 10; -fx-pref-height: 10; -fx-background-radius: 2;"/>
                            <Label text="Mágica" style="-fx-font-size: 10px; -fx-text-fill: #555;"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER">
                            <Label style="-fx-background-color: #9C27B0; -fx-pref-width: 10; -fx-pref-height: 10; -fx-background-radius: 2;"/>
                            <Label text="Surpresa" style="-fx-font-size: 10px; -fx-text-fill: #555;"/>
                        </HBox>
                    </HBox>
                </VBox>
                
                <VBox spacing="15" prefWidth="320" maxWidth="320" alignment="TOP_CENTER">
                    
                    <VBox spacing="6" style="-fx-background-color: #FDFDFB; -fx-padding: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">
                        <Label text="PLACAR" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #123516;"/>
                        <Separator/>
                        <ListView fx:id="placarListView" prefHeight="130" minHeight="130" maxHeight="130"
                                  style="-fx-font-size: 12px; -fx-font-family: 'Courier New'; -fx-background-color: #FAFAFA; -fx-border-color: #E0E0E0; -fx-border-radius: 4; -fx-background-radius: 4;"/>
                    </VBox>
                    
                    <VBox spacing="6" style="-fx-background-color: #FDFDFB; -fx-padding: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">
                        <Label text="LOG DE EVENTOS" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #123516;"/>
                        <Separator/>
                        <TextArea fx:id="logArea" editable="false" wrapText="true" prefHeight="500" minHeight="500" maxHeight="500"
                                  style="-fx-font-size: 11px; -fx-font-family: 'Consolas', 'Courier New'; -fx-control-inner-background: #FAFAFA; -fx-border-color: #E0E0E0; -fx-border-radius: 4; -fx-background-radius: 4;"/>
                    </VBox>
                </VBox>
            </HBox>
            
            <VBox spacing="10" style="-fx-background-color: #FDFDFB; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);" 
                  prefWidth="1040" minWidth="1040" maxWidth="1040">
                <Label text="CONTROLES" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #123516;"/>
                <Separator/>
                
                <HBox spacing="40" alignment="CENTER">
                    
                    <HBox spacing="12" alignment="CENTER">
                        <VBox alignment="CENTER" spacing="4">
                            <Label text="Dado 1" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <Label fx:id="dado1Label" text="-" 
                                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-background-color: #FAFAFA; -fx-border-color: #DDD; -fx-border-width: 1; -fx-pref-width: 48; -fx-pref-height: 48; -fx-alignment: center; -fx-background-radius: 6; -fx-border-radius: 6;"/>
                        </VBox>
                        
                        <Label text="+" style="-fx-font-size: 18px; -fx-text-fill: #999;"/>
                        
                        <VBox alignment="CENTER" spacing="4">
                            <Label text="Dado 2" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <Label fx:id="dado2Label" text="-" 
                                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-background-color: #FAFAFA; -fx-border-color: #DDD; -fx-border-width: 1; -fx-pref-width: 48; -fx-pref-height: 48; -fx-alignment: center; -fx-background-radius: 6; -fx-border-radius: 6;"/>
                        </VBox>
                        
                        <Label text="=" style="-fx-font-size: 18px; -fx-text-fill: #999;"/>
                        
                        <VBox alignment="CENTER" spacing="4">
                            <Label text="Total" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <Label fx:id="somaLabel" text="-" 
                                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-background-color: #FFD700; -fx-text-fill: #333; -fx-pref-width: 48; -fx-pref-height: 48; -fx-alignment: center; -fx-background-radius: 6;"/>
                        </VBox>
                    </HBox>
                    
                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="jogarDadosBtn" text="🎲 JOGAR DADOS" 
                                prefHeight="42" prefWidth="180"
                                style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        
                        <Button fx:id="proximoJogadorBtn" text="▶️ PRÓXIMO JOGADOR" 
                                prefHeight="42" prefWidth="180"
                                style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

                        <Button fx:id="voltarMenuBtn" text="🔄 VOLTAR PARA O MENU" 
                                prefHeight="42" prefWidth="200" visible="false" onAction="#handleVoltarMenu"
                                style="-fx-background-color: #D4AF37; -fx-text-fill: #123516; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>
                    
                    <HBox alignment="CENTER" spacing="12" style="-fx-background-color: #F5F5F5; -fx-padding: 8 15; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6;">
                        <CheckBox fx:id="modoDebugCheckBox" text="Modo Debug" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <HBox fx:id="debugBox" spacing="8" alignment="CENTER">
                            <Separator orientation="VERTICAL" prefHeight="20"/>
                            <Label text="Ir para casa:" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <TextField fx:id="casaDebugField" promptText="0-40" prefWidth="55" style="-fx-font-size: 11px; -fx-padding: 4;"/>
                        </HBox>
                    </HBox>
                    
                </HBox>
            </VBox>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: rgba(0, 0, 0, 0.2); -fx-padding: 6;">
            <Label text="Dica: Use o modo Debug para testar as casas especiais rapidamente." 
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255, 255, 255, 0.6); -fx-font-style: italic;"/>
        </HBox>
    </bottom>
    
</BorderPane>