<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="main.java.br.edu.uece.controller.GameController"
            style="-fx-background-color: linear-gradient(to bottom, #2e7d32, #1b5e20);">
    
    <!-- CABEÇALHO -->
    <top>
        <VBox style="-fx-background-color: rgba(0, 0, 0, 0.3); -fx-padding: 15;">
            <HBox alignment="CENTER" spacing="20">
                <Label text="🎲 JOGO DE TABULEIRO" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #FFD700;">
                    <font>
                        <Font name="System Bold" size="28"/>
                    </font>
                </Label>
            </HBox>
            
            <Separator style="-fx-background-color: #FFD700; -fx-padding: 5 0 0 0;"/>
            
            <!-- Informações do Jogador Atual -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                <Label text="Jogador Atual:" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="jogadorAtualLabel" text="---" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-color: rgba(255, 255, 255, 0.2); -fx-background-radius: 8;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- CONTEÚDO PRINCIPAL -->
    <center>
        <HBox spacing="20" style="-fx-padding: 20;">
            
            <!-- COLUNA ESQUERDA - Tabuleiro e Controles -->
            <VBox spacing="15" HBox.hgrow="ALWAYS">
                
                <!-- TABULEIRO -->
                <VBox spacing="10" style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 15, 0, 0, 5);">
                    <Label text="🎯 TABULEIRO" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                    <Separator/>
                    
                    <!-- Grid do Tabuleiro -->
                    <GridPane fx:id="tabuleiroGrid" hgap="2" vgap="2" alignment="CENTER"
                              style="-fx-background-color: #424242; -fx-padding: 5; -fx-background-radius: 10;">
                    </GridPane>
                    
                    <!-- Legenda -->
                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                        <VBox alignment="CENTER" spacing="3">
                            <HBox spacing="5" alignment="CENTER">
                                <Label style="-fx-background-color: #4CAF50; -fx-pref-width: 15; -fx-pref-height: 15; -fx-border-color: black;"/>
                                <Label text="Início" style="-fx-font-size: 9px;"/>
                            </HBox>
                        </VBox>
                        
                        <VBox alignment="CENTER" spacing="3">
                            <HBox spacing="5" alignment="CENTER">
                                <Label style="-fx-background-color: #FFD700; -fx-pref-width: 15; -fx-pref-height: 15; -fx-border-color: black;"/>
                                <Label text="Chegada" style="-fx-font-size: 9px;"/>
                            </HBox>
                        </VBox>
                        
                        <VBox alignment="CENTER" spacing="3">
                            <HBox spacing="5" alignment="CENTER">
                                <Label style="-fx-background-color: #FF5252; -fx-pref-width: 15; -fx-pref-height: 15; -fx-border-color: black;"/>
                                <Label text="Perde Vez" style="-fx-font-size: 9px;"/>
                            </HBox>
                        </VBox>
                        
                        <VBox alignment="CENTER" spacing="3">
                            <HBox spacing="5" alignment="CENTER">
                                <Label style="-fx-background-color: #2196F3; -fx-pref-width: 15; -fx-pref-height: 15; -fx-border-color: black;"/>
                                <Label text="Sorte" style="-fx-font-size: 9px;"/>
                            </HBox>
                        </VBox>
                        
                        <VBox alignment="CENTER" spacing="3">
                            <HBox spacing="5" alignment="CENTER">
                                <Label style="-fx-background-color: #E91E63; -fx-pref-width: 15; -fx-pref-height: 15; -fx-border-color: black;"/>
                                <Label text="Mágica" style="-fx-font-size: 9px;"/>
                            </HBox>
                        </VBox>
                        
                        <VBox alignment="CENTER" spacing="3">
                            <HBox spacing="5" alignment="CENTER">
                                <Label style="-fx-background-color: #9C27B0; -fx-pref-width: 15; -fx-pref-height: 15; -fx-border-color: black;"/>
                                <Label text="Surpresa" style="-fx-font-size: 9px;"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
                
                <!-- CONTROLES DO JOGO -->
                <VBox spacing="15" style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 15, 0, 0, 5);">
                    <Label text="🎮 CONTROLES" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                    <Separator/>
                    
                    <!-- Dados -->
                    <HBox spacing="20" alignment="CENTER">
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="Dado 1" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                            <Label fx:id="dado1Label" text="-" 
                                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-background-color: white; -fx-border-color: #2e7d32; -fx-border-width: 3; -fx-pref-width: 60; -fx-pref-height: 60; -fx-alignment: center; -fx-background-radius: 8; -fx-border-radius: 8;"/>
                        </VBox>
                        
                        <Label text="+" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                        
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="Dado 2" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                            <Label fx:id="dado2Label" text="-" 
                                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-background-color: white; -fx-border-color: #2e7d32; -fx-border-width: 3; -fx-pref-width: 60; -fx-pref-height: 60; -fx-alignment: center; -fx-background-radius: 8; -fx-border-radius: 8;"/>
                        </VBox>
                        
                        <Label text="=" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                        
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="Total" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                            <Label fx:id="somaLabel" text="-" 
                                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-background-color: #FFD700; -fx-border-color: #FFA000; -fx-border-width: 3; -fx-pref-width: 60; -fx-pref-height: 60; -fx-alignment: center; -fx-background-radius: 8; -fx-border-radius: 8;"/>
                        </VBox>
                    </HBox>
                    
                    <!-- Botões -->
                    <Button fx:id="jogarDadosBtn" text="🎲 JOGAR DADOS" 
                            prefHeight="50"
                            style="-fx-background-color: linear-gradient(to bottom, #43A047, #2E7D32); -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 3);">
                        <font>
                            <Font name="System Bold" size="18"/>
                        </font>
                    </Button>
                    
                    <Button fx:id="proximoJogadorBtn" text="▶️ PRÓXIMO JOGADOR" 
                            prefHeight="45"
                            style="-fx-background-color: linear-gradient(to bottom, #1E88E5, #1565C0); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;">
                        <font>
                            <Font name="System Bold" size="16"/>
                        </font>
                    </Button>
                    
                    <!-- Modo Debug -->
                    <Separator/>
                    <CheckBox fx:id="modoDebugCheckBox" text="🔧 Modo Debug (Escolher casa manualmente)" 
                              style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                    
                    <HBox fx:id="debugBox" spacing="10" alignment="CENTER">
                        <Label text="Casa destino:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="casaDebugField" promptText="0-40" prefWidth="80"
                                   style="-fx-font-size: 14px;"/>
                    </HBox>
                </VBox>
            </VBox>
            
            <!-- COLUNA DIREITA - Placar e Log -->
            <VBox spacing="15" prefWidth="350">
                
                <!-- PLACAR -->
                <VBox spacing="10" style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 15; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 15, 0, 0, 5);">
                    <Label text="🏆 PLACAR" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                    <Separator/>
                    <ListView fx:id="placarListView" prefHeight="200"
                              style="-fx-font-size: 13px; -fx-font-family: 'Courier New'; -fx-border-color: #2e7d32; -fx-border-width: 2; -fx-border-radius: 5;"/>
                </VBox>
                
                <!-- LOG DE EVENTOS -->
                <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 15; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 15, 0, 0, 5);">
                    <Label text="📜 LOG DE EVENTOS" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                    <Separator/>
                    <TextArea fx:id="logArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                              style="-fx-font-size: 12px; -fx-font-family: 'Consolas', 'Courier New'; -fx-control-inner-background: #f5f5f5; -fx-border-color: #2e7d32; -fx-border-width: 2; -fx-border-radius: 5;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>
    
    <!-- RODAPÉ -->
    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: rgba(0, 0, 0, 0.3); -fx-padding: 10;">
            <Label text="💡 Dica: Use o modo Debug para testar as casas especiais!" 
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255, 255, 255, 0.8); -fx-font-style: italic;"/>
        </HBox>
    </bottom>
    
</BorderPane>
